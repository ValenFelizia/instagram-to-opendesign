{
  "name": "instagram-to-opendesign",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest": "node bin/instagram-ingest.js",
    "evidence": "node bin/process-evidence.js",
    "analyze": "node bin/analyze-brand.js",
    "brand:instagram": "node --env-file=.env.local bin/brand-instagram.js",
    "brand:compile": "node bin/compile-brand.js",
    "brand:report": "node bin/brand-report.js",
    "brand:decisions": "node bin/brand-decisions.js",
    "brand:assets": "node bin/brand-assets.js",
    "brand:brief": "node bin/brand-brief.js",
    "brand:handoff": "node bin/brand-handoff.js",
    "test": "node --test test/*.test.js",
    "brand:accessibility": "node bin/brand-accessibility.js",
    "brand:deliver": "node bin/brand-deliver.js",
    "brand:result": "node bin/brand-result.js"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "sharp": "^0.35.5"
  }
}
